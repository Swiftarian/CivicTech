# ==========================================
# 生產環境變數配置範例
# ==========================================
# 請將此檔案複製為實際的環境變數，並填入真實的值
# 在 Railway 中，這些變數需要在專案設定中逐一添加

# ==========================================
# 資料庫配置（Railway MySQL）
# ==========================================
# Railway 會自動提供 MySQL 資料庫，使用以下變數名稱
DATABASE_URL=mysql://user:password@host:port/database

# ==========================================
# 伺服器配置
# ==========================================
NODE_ENV=production
PORT=3000

# ==========================================
# JWT 認證
# ==========================================
# 使用強密碼生成器產生，至少 32 字元
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# ==========================================
# Manus OAuth 配置
# ==========================================
VITE_APP_ID=your-manus-app-id
VITE_APP_TITLE=台東防災館綜合管理系統
VITE_APP_LOGO=/logo.png
VITE_OAUTH_PORTAL_URL=https://oauth.manus.space
OAUTH_SERVER_URL=https://oauth.manus.space

# ==========================================
# 應用程式網址
# ==========================================
# 設定為您的實際網域
VITE_APP_URL=https://taitungaibookingsystem.cc
APP_URL=https://taitungaibookingsystem.cc

# ==========================================
# AWS S3 配置（選填 - 用於檔案上傳）
# ==========================================
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=your-bucket-name

# ==========================================
# Email 通知配置（選填 - SMTP）
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=台東防災館 <your-email@gmail.com>

# ==========================================
# SMS 通知配置（選填 - Twilio）
# ==========================================
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ==========================================
# LINE 通知配置（選填）
# ==========================================
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
LINE_CHANNEL_SECRET=your-line-channel-secret

# ==========================================
# 分析配置（選填）
# ==========================================
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# ==========================================
# 重要提醒
# ==========================================
# 1. 所有 VITE_ 開頭的變數會被打包到前端，不要包含敏感資訊
# 2. JWT_SECRET 必須使用強密碼，建議至少 32 字元
# 3. 資料庫連線字串包含密碼，務必保密
# 4. 在 Railway 中設定環境變數時，不需要引號
# 5. Railway 的 MySQL 會自動提供 DATABASE_URL 變數
