# 資料庫連線
DATABASE_URL=mysql://username:password@host:port/database

# JWT 認證
JWT_SECRET=your-jwt-secret-key

# OAuth 設定
VITE_APP_ID=your-app-id
OAUTH_SERVER_URL=https://oauth.manus.space

# AWS S3 設定（檔案儲存）- 必填
# 用於圖片上傳功能（最新消息、相簿等）
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=ap-northeast-1
AWS_S3_BUCKET=your-bucket-name

# Email 通知設定
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-email-password
EMAIL_FROM=your-email@gmail.com

# SMS 通知設定（Twilio）
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number

# LINE 通知設定
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
LINE_CHANNEL_SECRET=your-line-channel-secret

# OpenAI API（如有使用 AI 功能）
OPENAI_API_KEY=your-openai-api-key

# 應用程式設定
NODE_ENV=development
PORT=3000

# 測試帳號密碼（選填 - 用於開發環境測試登入）
TEST_ADMIN_PASSWORD=your-test-admin-password
TEST_VOLUNTEER_PASSWORD=your-test-volunteer-password

# Google OAuth（選填）
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# 應用程式網址
APP_URL=https://taitungaibookingsystem.cc

# Google Maps API Key（前端使用）- 必填
# 用於地圖顯示功能（送餐追蹤、路線規劃等）
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
